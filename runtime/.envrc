# Prints the world's command list on entering it (direnv). start.py copies this file from the
# server build on every launch, so edit runtime/.envrc in the builder, not the copy.
world=$(basename "$PWD")
row() { printf '  %-38s %s\n' "$1" "$2"; }
echo "${world}: a Minecraft world, run by minecraft@${world}.service"
row "systemctl status minecraft@${world}" "state (start/stop/restart work too)"
row "journalctl -u minecraft@${world} -f" "console output; logs/latest.log has the game log"
row "mc-console ${world}" "attach to the console"
row "./control.sh check|players" "is it up, who is on (RCON)"
row "./control.sh say MESSAGE" "chat to everyone"
row "./control.sh stop -t SECONDS" "warn players, then stop the server"
row "server/bin/pack-docs" "read the pack options documentation"
unset -f row
