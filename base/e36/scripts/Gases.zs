
//RECIPES
//------------------------------------------------------------------------------------------------------------
#loader mekatweaker
import mods.mekatweaker.GasFactory;
import mods.mekatweaker.Gas;

//DRACONIUM PROCESSING

var cleandraconium = GasFactory.createGas("cleandraconium");
cleandraconium.setIcon("blocks/cleandraconium");
cleandraconium.register();

var dirtydraconium = GasFactory.createGas("dirtydraconium");
dirtydraconium.setIcon("blocks/dirtydraconium");
dirtydraconium.register();

var nitricAcid = GasFactory.createGas("nitricacid");
nitricAcid.setIcon("blocks/nitric_acid");
nitricAcid.register();

var nitrousAcid = GasFactory.createGas("nitrousacid");
nitrousAcid.setIcon("blocks/nitrous_acid");
nitrousAcid.register();

var nital = GasFactory.createGas("nital");
nital.setIcon("blocks/nital");
nital.register();

var nitrogen = GasFactory.createGas("nitrogen");
nitrogen.setIcon("blocks/nitrogen");
nitrogen.register();

var ethanol = GasFactory.createGas("ethanol");
ethanol.setIcon("blocks/ethanol");
ethanol.register();

var methane = GasFactory.createGas("methane");
methane.setIcon("blocks/methane");
methane.register();

