RuneAltar.removeRecipe(<botania:rune:13>);//RUNE OF WRATH
RuneAltar.removeRecipe(<botania:rune:14>);//RUNE OF ENVY
RuneAltar.removeRecipe(<botania:rune:15>);//RUNE OF PRIDE

RuneAltar.addRecipe(<botania:rune:1>*2,[<minecraft:netherbrick>,<minecraft:gunpowder>,<minecraft:nether_wart>,<botania:manaresource>,<botania:manaresource:23>,<contenttweaker:bedrock_shard>],5200);//RUNE OF FIRE
