RuneAltar.addRecipe(<botania:rune:3>*2,[<minecraft:string>,<minecraft:feather>,<minecraft:carpet>,<botania:manaresource>,<botania:manaresource:23>,<harvestcraft:windygarden>],5200);//RUNE OF AIR
