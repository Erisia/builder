RuneAltar.addRecipe(<botania:rune:6>,[<harvestcraft:pumpkinbreaditem>,<forestry:leaves.decorative.1>,<forestry:leaves.decorative.1>,<botania:rune:3>,<botania:rune:1>,<harvestcraft:spidereyesoupitem>],8000);//RUNE OF AUTUMN
RuneAltar.addRecipe(<botania:rune:7>,[<harvestcraft:holidaycakeitem>,<forestry:leaves.decorative.1:14>,<minecraft:wool>,<extraplanets:decorative_blocks:2>,<botania:rune>,<botania:rune:2>],8000);//RUNE OF WINTER
RuneAltar.addRecipe(<botania:rune:9>,[<contenttweaker:star_diamond>,<contenttweaker:star_diamond>,<xreliquary:fertile_lilypad>,<botania:rune:3>,<botania:rune:5>],12000);//RUNE OF LUST
RuneAltar.addRecipe(<botania:rune:10>,[<contenttweaker:star_diamond>,<contenttweaker:star_diamond>,<harvestcraft:cornedbeefbreakfastitem>,<botania:rune:1>,<botania:rune:7>],12000);//RUNE OF GLUTTONY
RuneAltar.addRecipe(<botania:rune:11>,[<contenttweaker:star_diamond>,<contenttweaker:star_diamond>,<harvestcraft:garliccoinitem>,<xreliquary:midas_touchstone>,<botania:rune:0>,<botania:rune:4>],12000);//RUNE OF GREED
RuneAltar.addRecipe(<botania:rune:12>,[<contenttweaker:star_diamond>,<contenttweaker:star_diamond>,<xreliquary:magazine:1>.withTag({effects: [{duration: 200, potency: 1, name: "minecraft:slowness"}]}),<botania:rune:3>,<botania:rune:6>],12000);//RUNE OF SLOTH
RuneAltar.addRecipe(<botania:rune:13>,[<contenttweaker:star_diamond>,<contenttweaker:star_diamond>,<xreliquary:pyromancer_staff>,<botania:rune:2>,<botania:rune:7>],12000);//RUNE OF WRATH
RuneAltar.addRecipe(<botania:rune:14>,[<contenttweaker:star_diamond>,<contenttweaker:star_diamond>,<xreliquary:rod_of_lyssa>,<botania:rune:0>,<botania:rune:7>],12000);//RUNE OF ENVY
